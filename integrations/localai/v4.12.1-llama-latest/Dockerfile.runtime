ARG BACKEND_IMAGE
FROM ${BACKEND_IMAGE} AS llama_backend

ARG LOCALAI_IMAGE
FROM ${LOCALAI_IMAGE}

ARG LOCALAI_COMMIT
ARG LLAMA_COMMIT

COPY --from=llama_backend / /var/lib/local-ai/backends/llama-cpp/

LABEL org.opencontainers.image.title="LocalAI v4.12.1 with pi0n00r llama.cpp" \
      org.opencontainers.image.source="https://github.com/pi0n00r/llama.cpp" \
      org.opencontainers.image.version="v4.12.1-llama-${LLAMA_COMMIT}" \
      com.bajaj.localai.commit="${LOCALAI_COMMIT}" \
      com.bajaj.llama-cpp.commit="${LLAMA_COMMIT}" \
      com.bajaj.localai.backend="llama-cpp/hipblas/gfx1151"
